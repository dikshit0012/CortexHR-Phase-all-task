# Copy to .streamlit/secrets.toml (git-ignored) or paste into Streamlit Cloud > App settings > Secrets.
CORTEXHR_API_URL = "https://your-live-api.example"   # API root, HTTPS
CORTEXHR_API_KEY = "paste-one-of-the-API's CORTEXHR_API_KEYS here"
CORTEXHR_CONSOLE_PASSWORD = "choose-a-long-password"  # strongly recommended: the console uses the API key on every visitor's behalf
# CORTEXHR_TIMEOUT_SECONDS = "30"
