# Copy to .env for local use. NEVER commit a real .env. All values below are placeholders.
CORTEXHR_ENV=development
# Comma-separated API keys accepted in the X-API-Key header. Generate with: python -c "import secrets; print(secrets.token_urlsafe(32))"
CORTEXHR_API_KEYS=replace-with-a-long-random-key
CORTEXHR_REQUIRE_AUTH=true
# Browser origins allowed to call the API cross-origin (the bundled dashboard is same-origin and needs nothing here)
CORTEXHR_CORS_ORIGINS=
CORTEXHR_MAX_BODY_BYTES=1000000
CORTEXHR_RATE_LIMIT_PER_MINUTE=120
CORTEXHR_MAX_BATCH=100

# --- Private data (never committed). Without them the dependent capabilities report "unavailable" / "precomputed". ---
# Headcount history export (sheet monthly_headcount_history). On Render: a Secret File -> /etc/secrets/monthly_headcount_history.csv
CORTEXHR_HEADCOUNT_CSV=
# Master workbook for the anomaly detectors. Mount it (persistent disk) or let the server download it over HTTPS (signed URL + SHA-256)
CORTEXHR_WORKBOOK=
CORTEXHR_WORKBOOK_URL=
CORTEXHR_WORKBOOK_SHA256=
# Optional JSON {"global": {"low_ratio": x, "high_ratio": y}, "by_level": {"3": {...}}} produced by the Task 15 pipeline
CORTEXHR_PAYBAND_CALIBRATION=
